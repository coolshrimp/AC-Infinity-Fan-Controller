<Window x:Class="ACInfinityDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ACInfinityDesktop" Title="AC Infinity Desktop" Width="450" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" Icon="ui/icon.ico" Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources><ResourceDictionary Source="Theme.xaml"/></Window.Resources>
 <Border x:Name="Shell" CornerRadius="20" Background="{DynamicResource WindowBrush}" BorderBrush="#404550" BorderThickness="1" PreviewMouseLeftButtonDown="Panel_Drag">
  <StackPanel Margin="16,12,16,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Click="Connection_Click" ToolTip="Choose a Bluetooth controller" Background="Transparent" BorderBrush="Transparent" Padding="0" Margin="0" HorizontalAlignment="Left">
     <StackPanel Orientation="Horizontal"><Image Source="ui/icon.png" Width="22" Height="22" Margin="0,0,9,0"/><TextBlock x:Name="DeviceNameText" Text="AC Infinity" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="16" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/><TextBlock Text="⌄" Margin="7,0,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
    </Button>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="12" ToolTip="Pin on top" AutomationProperties.Name="Pin on top" Click="Pin_Click" Width="25" Height="25" Padding="0" VerticalAlignment="Center" x:Name="PinButton" Background="Transparent" BorderBrush="Transparent" Margin="1">
                            <Path Width="16" Height="16" Data="M5,1 L11,1 L10,7 L13,10 L9,10 L9,15 L7,15 L7,10 L3,10 L6,7 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="PinTilt" Angle="45" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>

     <Button Content="⚙" Click="Settings_Click" ToolTip="Appearance and widget settings" Width="25" Height="25" Padding="0" Margin="1" Background="Transparent" BorderBrush="Transparent"/>
     <Button Content="−" Click="Tray_Click" ToolTip="Minimize to tray" Width="25" Height="25" Padding="0" Margin="1" Background="Transparent" BorderBrush="Transparent"/>
     <Button Content="×" Click="Close_Click" ToolTip="Quit" Width="25" Height="25" Padding="0" Margin="1" Background="Transparent" BorderBrush="Transparent"/>
    </StackPanel>
   </Grid>
   <DockPanel Margin="0,7,0,16"><Button Click="Connection_Click" DockPanel.Dock="Right" Padding="0" Margin="0" Background="Transparent" BorderBrush="Transparent" ToolTip="Bluetooth connection"><TextBlock x:Name="ConnectionBadge" Text="● Offline" FontSize="10"/></Button><TextBlock x:Name="UpdatedText" Text="No live readings" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
   <UniformGrid Columns="3">
    <StackPanel ToolTip="Air temperature measured by the controller sensor."><TextBlock Text="TEMPERATURE" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="TemperatureText" Text="—" FontSize="31" FontWeight="Light"/><Button x:Name="UnitButton" Content="°C" Click="Unit_Click" ToolTip="Switch temperature units" Padding="0" Margin="4,6,0,0" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" FontSize="10"/></StackPanel></StackPanel>
    <StackPanel ToolTip="Relative humidity: the moisture in the air compared with saturation, shown as a percentage."><TextBlock Text="HUMIDITY" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="HumidityText" Text="—" FontSize="31" FontWeight="Light"/><TextBlock Text="%" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,6,0,0"/></StackPanel></StackPanel>
    <StackPanel ToolTip="VPD means vapor pressure deficit: how far the air is from saturation, in kilopascals (kPa). Calculated from air temperature and humidity, without a leaf-temperature adjustment."><TextBlock Text="VPD · CALCULATED" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="VpdText" Text="—" FontSize="31" FontWeight="Light"/><TextBlock Text="kPa" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,6,0,0"/></StackPanel></StackPanel>
   </UniformGrid>
   <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="12" Margin="0,12,0,0"><StackPanel>
<Grid x:Name="DeviceStatusPanel" ToolTip="Controller-reported output from 0 to 10, not measured motor RPM. Both Controller 67 fan connections share this setting."><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image Source="ui/icon.png" Width="25" Height="25" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform x:Name="FanRotation"/></Image.RenderTransform></Image>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Fan speed" FontSize="12"/><TextBlock x:Name="ModeText" Text="Not connected" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="OutputText" Foreground="{DynamicResource AccentBrush}" Text="—" FontSize="27" FontWeight="Light"/><TextBlock Text=" / 10" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,8,5"/></StackPanel>
     <Button Grid.Column="3" Content="⋯" Click="Programs_Click" ToolTip="View stored controller programs" Padding="8,5" VerticalAlignment="Center"/>
    </Grid>
    <Border Height="1" Background="#35404D" Margin="0,12,0,10"/>
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="Drag to set speed" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
     <CheckBox x:Name="OnOffToggle" Style="{StaticResource UimToggleSwitch}" Background="{DynamicResource AccentBrush}" BorderBrush="#46515F" Foreground="{DynamicResource TextBrush}" Content="On / Off" VerticalAlignment="Center" ToolTip="Switch manual On / Off mode. Off uses the saved minimum speed and may still spin." AutomationProperties.Name="Manual fan On or Off" Click="OnOff_Click"/>
    </DockPanel>
     <Slider x:Name="SpeedSlider" Style="{StaticResource LiveSpeedSlider}" Foreground="{DynamicResource AccentBrush}" Background="#46515F" Minimum="0" Maximum="10" Value="0" Tag="0" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" IsMoveToPointEnabled="True" ToolTip="Drag to choose speed; release to apply. Colored fill shows reported speed. Zero selects saved Off mode." AutomationProperties.Name="Fan speed, applies on release" VerticalAlignment="Center" Margin="0,7,0,0"/>
     <TextBlock x:Name="PresetText" Text="Off mode uses the saved minimum speed." FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <StackPanel x:Name="ChartPanel" Visibility="Collapsed" Margin="0,12,0,0">
    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="HourButton" Content="1h" Tag="1" Click="Range_Click" Padding="7,3"/><Button x:Name="SixHourButton" Content="6h" Tag="6" Click="Range_Click" Padding="7,3"/><Button x:Name="DayButton" Content="24h" Tag="24" Click="Range_Click" Padding="7,3"/></StackPanel><TextBlock Text="SENSOR HISTORY" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
    <local:SensorChartView x:Name="HistoryChart"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Text="Choose a device to begin." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,4" MaxHeight="28" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Button x:Name="StatusTab" Content="Status" Tag="Status" Click="View_Click" Padding="8,5" FontSize="10"/><Button x:Name="ChartTab" Content="Chart" Tag="Chart" Click="View_Click" Padding="8,5" FontSize="10"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="HistoryButton" Content="History ↗" Click="History_Click" ToolTip="Review saved sensor history in a separate panel" Padding="7,3" FontSize="10"/><Button x:Name="RefreshButton" Content="↻" Click="Refresh_Click" ToolTip="Refresh readings" Padding="7,3"/><Button Content="?" Click="Help_Click" ToolTip="Help and about" Padding="7,3"/></StackPanel>
   </Grid>
   <Button Content="Created by: Coolshrimp Mods" Click="Credit_Click" ToolTip="Visit coolshrimpmodz.com" Background="Transparent" BorderBrush="Transparent" FontSize="9" Padding="0" Margin="0,8,0,0" HorizontalAlignment="Center"/>
  </StackPanel>
 </Border>
</Window>
