<Window x:Class="ACInfinityDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AC Infinity Desktop" Width="540" Height="740" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" MinWidth="460" MinHeight="640" Background="Transparent" Foreground="#EEF3F8" FontFamily="Segoe UI" Icon="ui/icon.ico" Closing="Window_Closing" Loaded="Window_Loaded">
 <Window.Resources>
 <SolidColorBrush x:Key="AccentBrush" Color="#91C7F2"/><SolidColorBrush x:Key="CardBrush" Color="#11151A"/><SolidColorBrush x:Key="HeaderBrush" Color="#1D222D"/>
 <Style TargetType="Expander"><Setter Property="Foreground" Value="#D4E5F8"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#293442"/><Setter Property="Foreground" Value="#E2EEFC"/><Setter Property="Padding" Value="14,8"/><Setter Property="BorderBrush" Value="#445366"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#96CDF9"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#11151A"/><Setter Property="Foreground" Value="#D4E5F8"/><Setter Property="BorderBrush" Value="#445366"/><Setter Property="Padding" Value="8"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#96A6B9"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="FontSize" Value="36"/><Setter Property="FontWeight" Value="Light"/></Style>
 </Window.Resources>
 <Border x:Name="Shell" CornerRadius="20" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Background="#171A20" PreviewMouseLeftButtonDown="Panel_Drag"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
  <DockPanel Margin="0,0,0,18">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="PinButton" Content="♧" ToolTip="Pin on top" AutomationProperties.Name="Pin on top" Click="Pin_Click" Padding="8,5"/>
    <Button Content="⚙" ToolTip="Appearance and preferences" AutomationProperties.Name="Settings" Click="Settings_Click" Padding="8,5"/>
    <Button Content="−" ToolTip="Minimize to tray" AutomationProperties.Name="Minimize to tray" Click="Tray_Click" Padding="8,5"/>
    <Button Content="×" ToolTip="Quit" AutomationProperties.Name="Quit" Click="Close_Click" Padding="8,5"/>
   </StackPanel>
   <StackPanel><TextBlock Text="LOCAL BLUETOOTH" Foreground="{DynamicResource AccentBrush}" FontSize="9"/><TextBlock Text="AC Infinity" FontSize="23" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,14"><StackPanel>
   <TextBlock Text="Appearance &amp; preferences" FontSize="15" Margin="0,0,0,12"/>
   <CheckBox x:Name="AutoConnectBox" Content="Connect automatically and retry if disconnected" Foreground="#D4E5F8" Click="Appearance_Changed" Margin="0,0,0,12"/>
   <TextBlock Text="Panel style" Style="{StaticResource Caption}"/>
   <ComboBox x:Name="ThemeBox" SelectionChanged="Appearance_Changed" SelectedIndex="0"><ComboBoxItem Content="Midnight"/><ComboBoxItem Content="Slate"/><ComboBoxItem Content="Forest"/></ComboBox>
   <TextBlock Text="Accent color" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
   <ComboBox x:Name="AccentBox" SelectionChanged="Appearance_Changed" SelectedIndex="0"><ComboBoxItem Content="Sky blue" Tag="#91C7F2"/><ComboBoxItem Content="Mint" Tag="#81E1B7"/><ComboBoxItem Content="Lavender" Tag="#BDA6FF"/><ComboBoxItem Content="Amber" Tag="#FFD28A"/><ComboBoxItem Content="Rose" Tag="#FFA6BF"/></ComboBox>
   <TextBlock Text="Panel opacity · subtle glass to solid" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
   <Slider x:Name="OpacitySlider" Minimum="45" Maximum="100" Value="94" ValueChanged="Appearance_Changed"/>
   <TextBlock Text="Preferences save automatically on this PC." FontSize="10" Foreground="#96A6B9" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <Border CornerRadius="18" Background="{DynamicResource CardBrush}" BorderBrush="#303846" BorderThickness="1"><StackPanel>
   <Border Background="{DynamicResource HeaderBrush}" CornerRadius="18,18,0,0" Padding="18"><DockPanel>
    <Button DockPanel.Dock="Right" Click="Connection_Click" ToolTip="Bluetooth connection settings" AutomationProperties.Name="Bluetooth connection settings" Padding="7,4" VerticalAlignment="Center"><TextBlock x:Name="ConnectionBadge" Text="● Offline"/></Button>
    <Image Source="ui/icon.png" Width="36" Height="36" Margin="0,0,12,0" DockPanel.Dock="Left"/>
    <StackPanel><TextBlock Text="CLOUDLINE T6" FontSize="17"/><TextBlock Text="Controller 67 · Shared fan control" Foreground="#96A6B9" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   </DockPanel></Border>
   <UniformGrid Columns="3" Margin="18,24,10,18">
    <StackPanel><TextBlock Text="TEMPERATURE" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="TemperatureText" Text="—" Style="{StaticResource Metric}"/><Button x:Name="UnitButton" Content="°C" Click="Unit_Click" Padding="2" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"/></StackPanel></StackPanel>
    <StackPanel><TextBlock Text="HUMIDITY" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource Metric}"/><TextBlock Text="%" Foreground="#96A6B9" Margin="5,8,0,0"/></StackPanel></StackPanel>
    <StackPanel><TextBlock Text="VPD · CALCULATED" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="VpdText" Text="—" Style="{StaticResource Metric}"/><TextBlock Text="kPa" Foreground="#96A6B9" Margin="5,8,0,0" FontSize="10"/></StackPanel></StackPanel>
   </UniformGrid>
   <DockPanel Margin="18,8,18,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="OutputText" Text="—" FontSize="34" FontWeight="Light"/><TextBlock Text=" / 10" Foreground="#96A6B9" VerticalAlignment="Bottom" Margin="0,0,0,7"/></StackPanel><StackPanel><TextBlock Text="6-inch inline fan" FontSize="14"/><TextBlock x:Name="ModeText" Text="Not connected" Foreground="#96A6B9" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel>
   <DockPanel Margin="18,0,18,6"><TextBlock x:Name="SpeedValue" Text="5" DockPanel.Dock="Right" Foreground="#8FCBFA"/><TextBlock Text="Manual speed" Foreground="#B7C5D7"/></DockPanel>
   <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Speed_Changed" IsEnabled="False" Margin="18,2,18,10"/>
   <UniformGrid Columns="3" Margin="15,8,15,10"><Button x:Name="OffButton" Content="Off mode" Click="Off_Click" IsEnabled="False"/><Button x:Name="OnButton" Content="Resume On" Click="On_Click" IsEnabled="False"/><Button x:Name="ApplyButton" Content="Apply speed" Click="Apply_Click" IsEnabled="False" Background="{DynamicResource AccentBrush}" Foreground="#11283A"/></UniformGrid>
   <TextBlock x:Name="PresetText" Text="Manual controls replace the active mode. Off mode uses the stored minimum speed." Foreground="#96A6B9" FontSize="10" TextWrapping="Wrap" Margin="18,0,18,14"/>
   <Border BorderBrush="#303846" BorderThickness="0,1,0,0" Padding="14,8"><DockPanel><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" DockPanel.Dock="Right" IsEnabled="False" Padding="8,3"/><TextBlock x:Name="UpdatedText" Text="No live readings" Foreground="#96A6B9" VerticalAlignment="Center" FontSize="10"/></DockPanel></Border>
  </StackPanel></Border>
  <StackPanel x:Name="ConnectionPanel" Visibility="Collapsed">
  <DockPanel Margin="0,16,0,8"><Button x:Name="ScanButton" Content="Scan Bluetooth" DockPanel.Dock="Right" Click="Scan_Click"/><Button x:Name="DisconnectButton" Content="Disconnect" DockPanel.Dock="Right" Click="Disconnect_Click" Visibility="Collapsed"/><TextBlock Text="Nearby controllers" FontSize="13" VerticalAlignment="Center"/></DockPanel>
  <TextBlock Text="Controller 67 address (optional)" Style="{StaticResource Caption}"/>
  <TextBox x:Name="AddressBox" MaxLength="17" FontFamily="Consolas" ToolTip="Enter the Bluetooth MAC, or leave empty to discover Controller 67 devices."/>
  <ListBox x:Name="DevicesList" DisplayMemberPath="Display" SelectionChanged="Device_Selected" Background="{DynamicResource CardBrush}" Foreground="#D4E5F8" BorderBrush="#303846" MaxHeight="100" Margin="0,8,0,0" Visibility="Collapsed"/>
  <Button x:Name="ConnectButton" Content="Connect selected controller" Click="Connect_Click" Visibility="Collapsed" IsEnabled="False"/>
  <Button Content="Open Windows Bluetooth settings ↗" Click="WindowsBluetooth_Click" HorizontalAlignment="Left" Padding="8,4"/>
  </StackPanel>
  <TextBlock x:Name="StatusText" Text="Close other AC Infinity apps, then scan for your controller." TextWrapping="Wrap" Foreground="#AFC1D7" FontSize="11" Margin="0,10,0,8"/>
  <Expander Header="Stored programs" Margin="0,5,0,5"><TextBlock x:Name="ProgramsText" Text="Connect to read stored timer, cycle, Auto, and schedule settings." Foreground="#AFC1D7" TextWrapping="Wrap" Margin="0,10,0,6" FontSize="12"/></Expander>
  <Expander Header="Connection help" Margin="0,6,0,0"><TextBlock Text="Keep the powered controller close to this PC. Disconnect the phone/Mac app first. The two fan connections share programming. VPD uses air temperature with no leaf offset. Use − to hide to the tray and × to quit. Drag the panel background to move it, even when pinned. This is an unofficial personal app." TextWrapping="Wrap" Foreground="#96A6B9" FontSize="11" Margin="0,10,0,0"/></Expander>
 </StackPanel></ScrollViewer></Border>
</Window>
