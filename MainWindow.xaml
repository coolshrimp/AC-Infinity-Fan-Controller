<Window x:Class="ACInfinityDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AC Infinity Desktop" Width="540" Height="740" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" MinWidth="460" MinHeight="640" Background="Transparent" Foreground="#EEF3F8" FontFamily="Segoe UI" Icon="ui/icon.ico" Closing="Window_Closing" Loaded="Window_Loaded">
 <Window.Resources><ResourceDictionary Source="Theme.xaml"/></Window.Resources>
 <Grid>
 <Border x:Name="Shell" CornerRadius="20" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Background="#171A20" PreviewMouseLeftButtonDown="Panel_Drag"><StackPanel Margin="20">
  <DockPanel Margin="0,0,0,18">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="PinButton" Content="♧" ToolTip="Pin on top" AutomationProperties.Name="Pin on top" Click="Pin_Click" Padding="8,5"/>
    <Button Content="⚙" ToolTip="Appearance and preferences" AutomationProperties.Name="Settings" Click="Settings_Click" Padding="8,5"/>
    <Button Content="−" ToolTip="Minimize to tray" AutomationProperties.Name="Minimize to tray" Click="Tray_Click" Padding="8,5"/>
    <Button Content="×" ToolTip="Quit" AutomationProperties.Name="Quit" Click="Close_Click" Padding="8,5"/>
   </StackPanel>
   <StackPanel><TextBlock Text="LOCAL BLUETOOTH" Foreground="{DynamicResource AccentBrush}" FontSize="9"/><TextBlock Text="AC Infinity" FontSize="23" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <Border CornerRadius="18" Background="{DynamicResource CardBrush}" BorderBrush="#303846" BorderThickness="1"><StackPanel>
   <Border Background="{DynamicResource HeaderBrush}" CornerRadius="18,18,0,0" Padding="18"><DockPanel>
    <Button DockPanel.Dock="Right" Click="Connection_Click" ToolTip="Bluetooth connection settings" AutomationProperties.Name="Bluetooth connection settings" Padding="7,4" VerticalAlignment="Center"><TextBlock x:Name="ConnectionBadge" Text="● Offline"/></Button>
    <Image Source="ui/icon.png" Width="36" Height="36" Margin="0,0,12,0" DockPanel.Dock="Left" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform x:Name="FanRotation"/></Image.RenderTransform></Image>
    <StackPanel><TextBlock Text="CLOUDLINE T6" FontSize="17"/><TextBlock Text="Controller 67 · Shared fan control" Foreground="#96A6B9" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   </DockPanel></Border>
   <UniformGrid Columns="3" Margin="18,24,10,18">
    <StackPanel><TextBlock Text="TEMPERATURE" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="TemperatureText" Text="—" Style="{StaticResource Metric}"/><Button x:Name="UnitButton" Content="°C" Click="Unit_Click" Padding="2" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"/></StackPanel></StackPanel>
    <StackPanel><TextBlock Text="HUMIDITY" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource Metric}"/><TextBlock Text="%" Foreground="#96A6B9" Margin="5,8,0,0"/></StackPanel></StackPanel>
    <StackPanel><TextBlock Text="VPD · CALCULATED" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="VpdText" Text="—" Style="{StaticResource Metric}"/><TextBlock Text="kPa" Foreground="#96A6B9" Margin="5,8,0,0" FontSize="10"/></StackPanel></StackPanel>
   </UniformGrid>
   <DockPanel Margin="18,8,18,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="OutputText" Text="—" FontSize="34" FontWeight="Light"/><TextBlock Text=" / 10" Foreground="#96A6B9" VerticalAlignment="Bottom" Margin="0,0,0,7"/></StackPanel><StackPanel><TextBlock Text="6-inch inline fan" FontSize="14"/><TextBlock x:Name="ModeText" Text="Not connected" Foreground="#96A6B9" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel>
   <DockPanel Margin="18,0,18,6"><TextBlock x:Name="SpeedValue" Text="5" DockPanel.Dock="Right" Foreground="#8FCBFA"/><TextBlock Text="Manual speed" Foreground="#B7C5D7"/></DockPanel>
   <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Speed_Changed" IsEnabled="False" Margin="18,2,18,10"/>
   <UniformGrid Columns="3" Margin="15,8,15,10"><Button x:Name="OffButton" Content="Off mode" Click="Off_Click" IsEnabled="False"/><Button x:Name="OnButton" Content="Resume On" Click="On_Click" IsEnabled="False"/><Button x:Name="ApplyButton" Content="Apply speed" Click="Apply_Click" IsEnabled="False" Background="{DynamicResource AccentBrush}" Foreground="#11283A"/></UniformGrid>
   <TextBlock x:Name="PresetText" Text="Manual controls replace the active mode. Off mode uses the stored minimum speed." Foreground="#96A6B9" FontSize="10" TextWrapping="Wrap" Margin="18,0,18,14"/>
   <Border BorderBrush="#303846" BorderThickness="0,1,0,0" Padding="14,8"><DockPanel><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" DockPanel.Dock="Right" IsEnabled="False" Padding="8,3"/><TextBlock x:Name="UpdatedText" Text="No live readings" Foreground="#96A6B9" VerticalAlignment="Center" FontSize="10"/></DockPanel></Border>
  </StackPanel></Border>
  <TextBlock x:Name="StatusText" Text="Close other AC Infinity apps, then scan for your controller." TextWrapping="Wrap" Foreground="#AFC1D7" FontSize="11" Margin="0,10,0,8"/>
  <StackPanel Orientation="Horizontal"><Button Content="Stored programs" Click="Programs_Click" Padding="10,5"/><Button Content="Connection help" Click="Help_Click" Padding="10,5"/></StackPanel>
 </StackPanel></Border>


</Grid>
</Window>
