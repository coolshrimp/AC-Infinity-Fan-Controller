<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ACInfinityDesktop.MainWindow" Title="AC Infinity Desktop" Width="538" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" MinWidth="500" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" Icon="ui/icon.ico" Closing="Window_Closing" Loaded="Window_Loaded" SizeToContent="Height">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml" />
    </Window.Resources>
    <Grid>
        <Border CornerRadius="18" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" x:Name="Shell" PreviewMouseLeftButtonDown="Panel_Drag">
            <StackPanel>
                <Grid Margin="16,8,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AC Infinity" FontSize="23" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button FontSize="12" ToolTip="Pin on top" AutomationProperties.Name="Pin on top" Click="Pin_Click" Width="30" Height="30" Padding="0" VerticalAlignment="Center" x:Name="PinButton">
                            <Path Width="16" Height="16" Data="M5,1 L11,1 L10,7 L13,10 L9,10 L9,15 L7,15 L7,10 L3,10 L6,7 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="PinTilt" Angle="45" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Appearance and preferences" AutomationProperties.Name="Appearance and preferences" Click="Settings_Click" Width="30" Height="30" Padding="0" VerticalAlignment="Center" />
                        <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Minimize to tray" AutomationProperties.Name="Minimize to tray" Click="Tray_Click" Width="30" Height="30" Padding="0" VerticalAlignment="Center" />
                        <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Quit app" AutomationProperties.Name="Quit app" Click="Close_Click" Width="30" Height="30" Padding="0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Border Background="{DynamicResource HeaderBrush}" CornerRadius="0" Padding="18">
                    <DockPanel>
                        <Image Source="ui/icon.png" Width="36" Height="36" Margin="0,0,12,0" DockPanel.Dock="Left" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="FanRotation" />
                            </Image.RenderTransform>
                        </Image>
                        <Button DockPanel.Dock="Right" Click="Connection_Click" ToolTip="Bluetooth connection settings" AutomationProperties.Name="Bluetooth connection settings" Padding="7,4" VerticalAlignment="Center">
                            <TextBlock x:Name="ConnectionBadge" Text="● Offline" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="LOCAL BLUETOOTH" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                            <TextBlock Text="CLOUDLINE T6" FontSize="17" />
                            <TextBlock Text="Controller 67 · Shared fan control" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <UniformGrid Columns="3" Margin="18,24,10,18">
                    <StackPanel>
                        <TextBlock Text="TEMPERATURE" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TemperatureText" Text="—" Style="{StaticResource Metric}" />
                            <Button x:Name="UnitButton" Content="°C" Click="Unit_Click" Padding="2" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" ToolTip="Switch between Celsius and Fahrenheit" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="HUMIDITY" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource Metric}" />
                            <TextBlock Text="%" Foreground="{DynamicResource MutedBrush}" Margin="5,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="VPD · CALCULATED" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="VpdText" Text="—" Style="{StaticResource Metric}" />
                            <TextBlock Text="kPa" Foreground="{DynamicResource MutedBrush}" Margin="5,8,0,0" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </UniformGrid>
                <DockPanel Margin="18,8,18,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="OutputText" Text="—" FontSize="34" FontWeight="Light" />
                        <TextBlock Text=" / 10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="6-inch inline fan" FontSize="14" />
                        <TextBlock x:Name="ModeText" Text="Not connected" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock x:Name="StatusText" Text="Close other AC Infinity apps, then scan for your controller." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="18,0,18,6">
                    <TextBlock x:Name="SpeedValue" Text="5" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="Manual speed" Foreground="{DynamicResource MutedBrush}" />
                </DockPanel>
                <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Speed_Changed" IsEnabled="False" Margin="18,2,18,10" ToolTip="Choose a speed from 1 to 10, then click Apply speed" />
                <UniformGrid Columns="3" Margin="15,8,15,10">
                    <Button x:Name="OffButton" Content="Off mode" Click="Off_Click" IsEnabled="False" ToolTip="Use the saved Off speed (which may be above zero)" />
                    <Button x:Name="OnButton" Content="Resume On" Click="On_Click" IsEnabled="False" ToolTip="Resume manual On mode at the saved speed" />
                    <Button x:Name="ApplyButton" Content="Apply speed" Click="Apply_Click" IsEnabled="False" Background="{DynamicResource AccentBrush}" Foreground="#11283A" ToolTip="Apply the selected manual speed" />
                </UniformGrid>
                <TextBlock x:Name="PresetText" Text="Manual controls replace the active mode. Off mode uses the stored minimum speed." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="18,0,18,14" />
                <Border BorderBrush="#303846" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpdatedText" Text="No live readings" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="10" Grid.Column="0" />
                        <Button Content="Connection help" Click="Help_Click" Padding="10,5" Grid.Column="1" ToolTip="Open connection help" />
                        <Button Content="Stored programs" Click="Programs_Click" Padding="10,5" Grid.Column="2" ToolTip="View stored controller programs" />
                        <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" IsEnabled="False" Padding="8,3" Grid.Column="3" ToolTip="Read current controller status" />
                    </Grid>
                </Border>
                <Button Content="Created by: Coolshrimp Mods" Click="Credit_Click" ToolTip="Visit coolshrimpmodz.com" FontSize="10" Padding="8,4" HorizontalAlignment="Center" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>