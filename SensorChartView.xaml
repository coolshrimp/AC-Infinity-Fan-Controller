<UserControl x:Class="ACInfinityDesktop.SensorChartView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
 <StackPanel Margin="0,8,0,0">
  <TextBlock x:Name="EmptyText" Text="History appears after two live readings. Keep the app connected to collect data." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,10"/>
  <StackPanel x:Name="Plots" Visibility="Collapsed">
   <DockPanel><TextBlock x:Name="TempRange" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="TEMPERATURE" FontSize="9" Foreground="#EBA07D"/></DockPanel><Canvas x:Name="TempCanvas" Height="44" Margin="0,3,0,10" ClipToBounds="True"/>
   <DockPanel><TextBlock x:Name="HumidityRange" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="HUMIDITY" FontSize="9" Foreground="#8DB9EE"/></DockPanel><Canvas x:Name="HumidityCanvas" Height="44" Margin="0,3,0,10" ClipToBounds="True"/>
   <DockPanel><TextBlock x:Name="VpdRange" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="VPD" FontSize="9" Foreground="#93CEA1"/></DockPanel><Canvas x:Name="VpdCanvas" Height="44" Margin="0,3,0,7" ClipToBounds="True"/>
  </StackPanel>
  <DockPanel><TextBlock Text="Now" DockPanel.Dock="Right" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="StartLabel" FontSize="9" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
  <TextBlock Text="Collected on this PC · separate scales · gaps mean no readings" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
 </StackPanel>
</UserControl>
