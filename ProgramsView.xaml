<UserControl x:Class="ACInfinityDesktop.ProgramsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" HorizontalContentAlignment="Stretch">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Fan schedules" FontSize="16" Margin="0,0,0,10"/>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="ControllerTab" Content="Controller" Tag="Controller" Click="Section_Click" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,4,0" ToolTip="Programs saved directly on the Bluetooth controller" AutomationProperties.Name="Controller programs"/>
   <Button x:Name="ThisPcTab" Grid.Column="1" Content="This PC" Tag="App" Click="Section_Click" Background="{DynamicResource HeaderBrush}" Margin="4,0,0,0" ToolTip="A daily time window and repeating cycle run by this app" AutomationProperties.Name="This PC schedules"/>
  </Grid>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
   <Grid>
    <StackPanel x:Name="ControllerSection">
     <TextBlock Text="Saved on the controller" FontSize="14" Margin="0,0,0,6"/>
     <TextBlock Text="Runs independently of this app or PC. Choose the controller mode to view or edit. For a daily window with a repeating cycle, use This PC." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,14"/>
     <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="12">
      <StackPanel>
       <TextBlock Text="Controller mode" Style="{DynamicResource Caption}" Margin="0,0,0,5"/>
       <ComboBox x:Name="ProgramKindBox" Style="{DynamicResource ModernCombo}" SelectedIndex="6" SelectionChanged="ProgramKind_Changed" ToolTip="Choose the controller mode whose settings you want to edit" AutomationProperties.Name="Controller program mode">
        <ComboBoxItem Content="Manual Off" Tag="1"/>
        <ComboBoxItem Content="Manual On" Tag="2"/>
        <ComboBoxItem Content="Auto thresholds" Tag="3"/>
        <ComboBoxItem Content="Timer to On" Tag="4"/>
        <ComboBoxItem Content="Timer to Off" Tag="5"/>
        <ComboBoxItem Content="Repeating cycle" Tag="6"/>
        <ComboBoxItem Content="Daily schedule" Tag="7"/>
       </ComboBox>
       <StackPanel x:Name="ControllerAutoPanel" Visibility="Collapsed" Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Temperature thresholds · " FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="AutoUnitText" Text="°C" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
         <CheckBox x:Name="HighTemperatureEnabledBox" Content="High temperature" Style="{DynamicResource UimToggleSwitch}" Background="{DynamicResource AccentBrush}" BorderBrush="#46515F" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" ToolTip="Enable the high-temperature threshold independently" AutomationProperties.Name="Enable high temperature threshold"/>
         <TextBox x:Name="HighTemperatureBox" Grid.Column="1" Text="30" MaxLength="7" IsEnabled="{Binding IsChecked, ElementName=HighTemperatureEnabledBox}" ToolTip="High-temperature threshold in the displayed temperature unit" AutomationProperties.Name="High temperature threshold"/>
        </Grid>
        <Grid Margin="0,8,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
         <CheckBox x:Name="LowTemperatureEnabledBox" Content="Low temperature" Style="{DynamicResource UimToggleSwitch}" Background="{DynamicResource AccentBrush}" BorderBrush="#46515F" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" ToolTip="Enable the low-temperature threshold independently" AutomationProperties.Name="Enable low temperature threshold"/>
         <TextBox x:Name="LowTemperatureBox" Grid.Column="1" Text="18" MaxLength="7" IsEnabled="{Binding IsChecked, ElementName=LowTemperatureEnabledBox}" ToolTip="Low-temperature threshold in the displayed temperature unit" AutomationProperties.Name="Low temperature threshold"/>
        </Grid>
        <TextBlock Text="Humidity thresholds · %" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,13,0,8"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
         <CheckBox x:Name="HighHumidityEnabledBox" Content="High humidity" Style="{DynamicResource UimToggleSwitch}" Background="{DynamicResource AccentBrush}" BorderBrush="#46515F" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" ToolTip="Enable the high-humidity threshold independently" AutomationProperties.Name="Enable high humidity threshold"/>
         <TextBox x:Name="HighHumidityBox" Grid.Column="1" Text="70" MaxLength="3" IsEnabled="{Binding IsChecked, ElementName=HighHumidityEnabledBox}" ToolTip="High relative-humidity threshold, as a percentage" AutomationProperties.Name="High humidity threshold"/>
        </Grid>
        <Grid Margin="0,8,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
         <CheckBox x:Name="LowHumidityEnabledBox" Content="Low humidity" Style="{DynamicResource UimToggleSwitch}" Background="{DynamicResource AccentBrush}" BorderBrush="#46515F" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" ToolTip="Enable the low-humidity threshold independently" AutomationProperties.Name="Enable low humidity threshold"/>
         <TextBox x:Name="LowHumidityBox" Grid.Column="1" Text="35" MaxLength="3" IsEnabled="{Binding IsChecked, ElementName=LowHumidityEnabledBox}" ToolTip="Low relative-humidity threshold, as a percentage" AutomationProperties.Name="Low humidity threshold"/>
        </Grid>
        <TextBlock Text="Each threshold is independent. Enable the thresholds you want the controller to use." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,8,0,0"/>
       </StackPanel>
       <StackPanel x:Name="ControllerTimerOnPanel" Visibility="Collapsed" Margin="0,14,0,0">
        <TextBlock Text="Timer to On · HH:mm:ss" FontSize="11" Margin="0,0,0,5"/>
        <TextBox x:Name="TimerOnBox" Text="00:30:00" MaxLength="12" FontFamily="Consolas" ToolTip="Time before switching to the saved On preset, in hours:minutes:seconds" AutomationProperties.Name="Timer to On duration"/>
       </StackPanel>
       <StackPanel x:Name="ControllerTimerOffPanel" Visibility="Collapsed" Margin="0,14,0,0">
        <TextBlock Text="Timer to Off · HH:mm:ss" FontSize="11" Margin="0,0,0,5"/>
        <TextBox x:Name="TimerOffBox" Text="00:30:00" MaxLength="12" FontFamily="Consolas" ToolTip="Time before switching to the saved Off preset, in hours:minutes:seconds" AutomationProperties.Name="Timer to Off duration"/>
       </StackPanel>
       <StackPanel x:Name="ControllerCyclePanel" Visibility="Collapsed" Margin="0,14,0,0">
        <TextBlock Text="Repeat continuously" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,6,0"><TextBlock Text="Run for · HH:mm:ss" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerOnMinutesBox" Text="00:05:00" MaxLength="12" FontFamily="Consolas" ToolTip="Duration at the run speed, in hours:minutes:seconds" AutomationProperties.Name="Controller cycle run duration"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Idle for · HH:mm:ss" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerOffMinutesBox" Text="00:10:00" MaxLength="12" FontFamily="Consolas" ToolTip="Duration at the idle speed, in hours:minutes:seconds" AutomationProperties.Name="Controller cycle idle duration"/></StackPanel>
        </Grid>
       </StackPanel>
       <StackPanel x:Name="ControllerDailyPanel" Margin="0,14,0,0">
        <TextBlock Text="Daily time window · 24-hour clock" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,6,0"><TextBlock Text="Start time" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerStartBox" Text="08:00" MaxLength="5" FontFamily="Consolas" ToolTip="Start time on the controller clock, HH:mm" AutomationProperties.Name="Controller daily start time"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="End time" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerEndBox" Text="20:00" MaxLength="5" FontFamily="Consolas" ToolTip="End time on the controller clock, HH:mm; overnight windows are allowed" AutomationProperties.Name="Controller daily end time"/></StackPanel>
        </Grid>
        <TextBlock Text="Uses the controller clock; this app does not synchronize it. Check the controller time before saving. Outside this window, the fan uses the idle speed. Overnight windows are allowed." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
       </StackPanel>
       <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,6,0"><TextBlock Text="Run speed · 0–10" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerRunSpeedBox" Text="5" MaxLength="2" ToolTip="Saved On speed, from 0 to 10; zero can stop output" AutomationProperties.Name="Controller run speed"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Idle speed · 0–10" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerIdleSpeedBox" Text="0" MaxLength="2" ToolTip="Saved Off speed, from 0 to 10; a value above zero can still spin the fan" AutomationProperties.Name="Controller idle speed"/></StackPanel>
       </Grid>
       <TextBlock Text="These are the controller's shared On/Off presets. Zero can stop output; an Off preset above zero can still spin the fan." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,8,0,0"/>
       <TextBlock Text="Save settings keeps the current mode. Save &amp; activate also switches to the mode selected above." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,10,0,0"/>

      </StackPanel>
     </Border>
     <TextBlock Text="Current controller settings" FontSize="12" Margin="0,14,0,4"/>
     <TextBlock x:Name="ProgramsText" Text="Connect to read stored timer, cycle, Auto, and schedule settings." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
    </StackPanel>
    <StackPanel x:Name="AppSection" Visibility="Collapsed">
     <TextBlock Text="Daily window with a repeating cycle" FontSize="14" Margin="0,0,0,6"/>
     <TextBlock Text="This app runs the cycle inside your daily time window and uses the idle speed outside it. Your PC must stay awake, this app must stay running, and Bluetooth must stay connected." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,14"/>
     <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="12">
      <StackPanel>
       <TextBlock Text="Daily time window · this PC's 24-hour clock" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,6,0"><TextBlock Text="Start time" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppStartBox" Text="08:00" MaxLength="5" FontFamily="Consolas" ToolTip="Daily start time on this PC, HH:mm" AutomationProperties.Name="This PC daily start time"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="End time" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppEndBox" Text="20:00" MaxLength="5" FontFamily="Consolas" ToolTip="Daily end time on this PC, HH:mm; equal start and end means all day" AutomationProperties.Name="This PC daily end time"/></StackPanel>
       </Grid>
       <TextBlock Text="Overnight windows are allowed. Equal start and end times mean all day." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
       <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,6,0"><TextBlock Text="Run for · minutes" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppOnMinutesBox" Text="5" MaxLength="6" ToolTip="Minutes at the run speed in each repeating cycle" AutomationProperties.Name="This PC cycle run minutes"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Idle for · minutes" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppOffMinutesBox" Text="10" MaxLength="6" ToolTip="Minutes at the idle speed in each repeating cycle" AutomationProperties.Name="This PC cycle idle minutes"/></StackPanel>
       </Grid>
       <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,6,0"><TextBlock Text="Run speed · 1–10" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppRunSpeedBox" Text="5" MaxLength="2" ToolTip="Fan output during the run part of the cycle, from 1 to 10" AutomationProperties.Name="This PC run speed"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Idle speed · 0–10" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppIdleSpeedBox" Text="0" MaxLength="2" ToolTip="Fan output during idle and outside the daily window, from 0 to 10" AutomationProperties.Name="This PC idle speed"/></StackPanel>
       </Grid>

       <TextBlock x:Name="AppStatusText" Text="No app schedule running." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,11,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Border>
     <TextBlock Text="Minimizing to the tray keeps the schedule running. Stopping restores the controller's previous mode and On/Off speed presets. Quitting also restores them; an enabled schedule resumes when you reopen and reconnect. Bluetooth loss or PC sleep leaves the controller at its last setting until this app reconnects." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,13,0,2"/>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <!-- Actions stay visible while the settings above them scroll. -->
  <Grid x:Name="ControllerActions" Grid.Row="3" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="ReadControllerButton" Content="Read settings" Margin="0,0,4,0" FontSize="11" Padding="6,8" ToolTip="Load the controller's saved settings into these fields" AutomationProperties.Name="Read controller program settings"/>
   <Button x:Name="SaveControllerButton" Grid.Column="1" Content="Save settings" Margin="4,0,4,0" FontSize="11" Padding="6,8" ToolTip="Save the selected program and speed presets without changing the active mode" AutomationProperties.Name="Save controller settings without activating"/>
   <Button x:Name="ApplyControllerButton" Grid.Column="2" Content="Save &amp; activate" Margin="4,0,0,0" FontSize="11" Padding="6,8" BorderBrush="{DynamicResource AccentBrush}" ToolTip="Save the settings and switch to the selected controller mode" AutomationProperties.Name="Save and activate controller program"/>
  </Grid>
  <Grid x:Name="AppActions" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="StartAppButton" Content="Save &amp; start" Margin="0,0,4,0" FontSize="11" Padding="6,8" BorderBrush="{DynamicResource AccentBrush}" ToolTip="Save this PC's schedule and start running it" AutomationProperties.Name="Save and start This PC schedule"/>
   <Button x:Name="StopAppButton" Grid.Column="1" Content="Stop &amp; restore" Margin="4,0,0,0" FontSize="11" Padding="6,8" ToolTip="Stop this PC's schedule and restore the controller's previous mode and speed presets" AutomationProperties.Name="Stop This PC schedule and restore controller"/>
  </Grid>
  <TextBlock x:Name="ProgramActionText" Grid.Row="4" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</UserControl>
