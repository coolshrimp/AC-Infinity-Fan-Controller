<Window x:Class="ACInfinityDesktop.ProgramsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fan schedules" Width="500" MaxHeight="760" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Window.Resources><ResourceDictionary Source="Theme.xaml"/></Window.Resources>
 <Border x:Name="PanelShell" Padding="18" CornerRadius="18" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontFamily="Segoe UI">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,10" MouseLeftButtonDown="Header_Drag">
    <Button Content="×" Click="Close_Click" DockPanel.Dock="Right" Padding="8,3" ToolTip="Close panel; an active schedule keeps running" AutomationProperties.Name="Close Fan schedules"/>
    <TextBlock Text="Fan schedules" FontSize="18" VerticalAlignment="Center"/>
   </DockPanel>
   <Grid Grid.Row="1" Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="ControllerTab" Content="Controller" Tag="Controller" Click="Section_Click" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,4,0" ToolTip="Schedules saved directly on the Bluetooth controller" AutomationProperties.Name="Controller schedules"/>
    <Button x:Name="ThisPcTab" Grid.Column="1" Content="This PC" Tag="App" Click="Section_Click" Background="{DynamicResource HeaderBrush}" Margin="4,0,0,0" ToolTip="A daily time window and repeating cycle run by this app" AutomationProperties.Name="This PC schedules"/>
   </Grid>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="595" Padding="0,0,6,0">
    <Grid>
     <StackPanel x:Name="ControllerSection">
      <TextBlock Text="Saved on the controller" FontSize="14" Margin="0,0,0,6"/>
      <TextBlock Text="Keeps running when this app or PC is off. Choose a basic daily schedule or repeating cycle. For a cycle limited to certain hours, use This PC." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,14"/>
      <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14">
       <StackPanel>
        <TextBlock Text="Schedule type" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
        <ComboBox x:Name="ProgramKindBox" Style="{StaticResource ModernCombo}" SelectedIndex="0" SelectionChanged="ProgramKind_Changed" ToolTip="Choose a daily time window or a repeating cycle" AutomationProperties.Name="Controller schedule type">
         <ComboBoxItem Content="Daily schedule" Tag="7"/>
         <ComboBoxItem Content="Repeating cycle" Tag="6"/>
        </ComboBox>
        <StackPanel x:Name="ControllerDailyPanel" Margin="0,14,0,0">
         <TextBlock Text="Daily time window · 24-hour clock" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0"><TextBlock Text="Start time" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerStartBox" Text="08:00" MaxLength="5" FontFamily="Consolas" ToolTip="Start time on the controller clock, HH:mm" AutomationProperties.Name="Controller daily start time"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="End time" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerEndBox" Text="20:00" MaxLength="5" FontFamily="Consolas" ToolTip="End time on the controller clock, HH:mm; overnight windows are allowed" AutomationProperties.Name="Controller daily end time"/></StackPanel>
         </Grid>
         <TextBlock Text="Uses the controller clock; this app does not synchronize it. Check the time on your controller before saving. Outside this window, the fan uses the idle speed. Overnight windows are allowed." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
        </StackPanel>
        <StackPanel x:Name="ControllerCyclePanel" Visibility="Collapsed" Margin="0,14,0,0">
         <TextBlock Text="Repeat continuously" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0"><TextBlock Text="Run for · minutes" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerOnMinutesBox" Text="5" MaxLength="6" ToolTip="Minutes at the run speed in each repeating cycle" AutomationProperties.Name="Controller cycle run minutes"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Idle for · minutes" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerOffMinutesBox" Text="10" MaxLength="6" ToolTip="Minutes at the idle speed in each repeating cycle" AutomationProperties.Name="Controller cycle idle minutes"/></StackPanel>
         </Grid>
        </StackPanel>
        <Grid Margin="0,14,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,6,0"><TextBlock Text="Run speed · 1–10" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerRunSpeedBox" Text="5" MaxLength="2" ToolTip="Saved On speed, from 1 to 10" AutomationProperties.Name="Controller run speed"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Idle speed · 0–10" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ControllerIdleSpeedBox" Text="0" MaxLength="2" ToolTip="Saved Off speed, from 0 to 10; zero stops output" AutomationProperties.Name="Controller idle speed"/></StackPanel>
        </Grid>
        <TextBlock Text="Saving replaces the selected controller program and its On/Off speed presets, then activates that mode." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,10,0,0"/>
        <Grid Margin="0,12,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="ReadControllerButton" Content="Read settings" Margin="0,0,4,0" Padding="9,8" ToolTip="Load the controller's saved program into these fields" AutomationProperties.Name="Read controller schedule settings"/>
         <Button x:Name="ApplyControllerButton" Grid.Column="1" Content="Save &amp; activate" Margin="4,0,0,0" Padding="9,8" BorderBrush="{DynamicResource AccentBrush}" ToolTip="Save these settings to the controller and activate the selected mode" AutomationProperties.Name="Save and activate controller schedule"/>
        </Grid>
       </StackPanel>
      </Border>
      <TextBlock Text="Current controller settings" FontSize="12" Margin="0,14,0,4"/>
      <TextBlock x:Name="ProgramsText" Text="Connect to read stored timer, cycle, Auto, and schedule settings." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>
     </StackPanel>
     <StackPanel x:Name="AppSection" Visibility="Collapsed">
      <TextBlock Text="Daily window with a repeating cycle" FontSize="14" Margin="0,0,0,6"/>
      <TextBlock Text="This app runs the cycle inside your daily time window and uses the idle speed outside it. Your PC must stay awake, this app must stay running, and Bluetooth must stay connected." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,14"/>
      <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14">
       <StackPanel>
        <TextBlock Text="Daily time window · this PC's 24-hour clock" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,6,0"><TextBlock Text="Start time" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppStartBox" Text="08:00" MaxLength="5" FontFamily="Consolas" ToolTip="Daily start time on this PC, HH:mm" AutomationProperties.Name="This PC daily start time"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="End time" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppEndBox" Text="20:00" MaxLength="5" FontFamily="Consolas" ToolTip="Daily end time on this PC, HH:mm; equal start and end means all day" AutomationProperties.Name="This PC daily end time"/></StackPanel>
        </Grid>
        <TextBlock Text="Overnight windows are allowed. Equal start and end times mean all day." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
        <Grid Margin="0,14,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,6,0"><TextBlock Text="Run for · minutes" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppOnMinutesBox" Text="5" MaxLength="6" ToolTip="Minutes at the run speed in each repeating cycle" AutomationProperties.Name="This PC cycle run minutes"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Idle for · minutes" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppOffMinutesBox" Text="10" MaxLength="6" ToolTip="Minutes at the idle speed in each repeating cycle" AutomationProperties.Name="This PC cycle idle minutes"/></StackPanel>
        </Grid>
        <Grid Margin="0,14,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,6,0"><TextBlock Text="Run speed · 1–10" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppRunSpeedBox" Text="5" MaxLength="2" ToolTip="Fan output during the run part of the cycle, from 1 to 10" AutomationProperties.Name="This PC run speed"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Idle speed · 0–10" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="AppIdleSpeedBox" Text="0" MaxLength="2" ToolTip="Fan output during idle and outside the daily window, from 0 to 10" AutomationProperties.Name="This PC idle speed"/></StackPanel>
        </Grid>
        <Grid Margin="0,14,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="StartAppButton" Content="Save &amp; start" Margin="0,0,4,0" Padding="9,8" BorderBrush="{DynamicResource AccentBrush}" ToolTip="Save this PC's schedule and start running it" AutomationProperties.Name="Save and start This PC schedule"/>
         <Button x:Name="StopAppButton" Grid.Column="1" Content="Stop &amp; restore" Margin="4,0,0,0" Padding="9,8" ToolTip="Stop this PC's schedule and restore the controller's previous mode and speed presets" AutomationProperties.Name="Stop This PC schedule and restore controller"/>
        </Grid>
        <TextBlock x:Name="AppStatusText" Text="No app schedule running." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,11,0,0" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>
      <TextBlock Text="Minimizing to the tray keeps the schedule running. Stopping restores the controller's previous mode and On/Off speed presets. Quitting also restores them; an enabled schedule resumes when you reopen and reconnect. Bluetooth loss or PC sleep leaves the controller at its last setting until this app reconnects." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,13,0,2"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock x:Name="ProgramActionText" Grid.Row="3" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Border>
</Window>