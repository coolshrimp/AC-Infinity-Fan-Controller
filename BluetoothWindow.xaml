<Window x:Class="ACInfinityDesktop.BluetoothWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bluetooth" Width="500" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Window.Resources><ResourceDictionary Source="Theme.xaml"/></Window.Resources>
<Border x:Name="PanelShell" Padding="18" CornerRadius="18" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontFamily="Segoe UI">
   <StackPanel><DockPanel Margin="0,0,0,10"><Button Content="×" Click="Close_Click" DockPanel.Dock="Right" Padding="8,3" ToolTip="Close panel" AutomationProperties.Name="Close Bluetooth"/><TextBlock Text="Bluetooth" FontSize="18" VerticalAlignment="Center"/></DockPanel>
  <StackPanel x:Name="ConnectionPanel">
  <DockPanel Margin="0,16,0,8"><Button x:Name="ScanButton" ToolTip="Find nearby Bluetooth controllers" Content="Scan Bluetooth" DockPanel.Dock="Right"/><Button x:Name="DisconnectButton" ToolTip="Disconnect and pause automatic reconnection" Content="Disconnect" DockPanel.Dock="Right" Visibility="Collapsed"/><TextBlock Text="Nearby controllers" FontSize="13" VerticalAlignment="Center"/></DockPanel>
  <TextBlock Text="Your Bluetooth address (optional)" Style="{StaticResource Caption}"/>
  <TextBlock Text="Enter your address if you know it, or leave blank and choose a detected controller." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
  <TextBox x:Name="AddressBox" MaxLength="17" FontFamily="Consolas" ToolTip="Enter the Bluetooth MAC, or leave empty to discover Controller 67 devices."/>
  <ListBox x:Name="DevicesList" ToolTip="Select the controller to connect to"  Background="{DynamicResource CardBrush}" Foreground="#D4E5F8" BorderBrush="#303846" MaxHeight="100" Margin="0,8,0,0" Visibility="Collapsed">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Mac}" FontFamily="Consolas" FontSize="11"/><TextBlock Text="{Binding Verification}" TextWrapping="Wrap" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Button x:Name="ConnectButton" ToolTip="Connect to the selected controller" Content="Connect selected controller" Visibility="Collapsed" IsEnabled="False"/>
  <Button x:Name="WindowsBluetoothButton" ToolTip="Open Windows Bluetooth settings" Content="Open Windows Bluetooth settings ↗" HorizontalAlignment="Left" Padding="8,4"/>
  </StackPanel>
<TextBlock x:Name="ConnectionStatusText" Text="Ready to connect." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
   </StackPanel>
  </Border>
</Window>
