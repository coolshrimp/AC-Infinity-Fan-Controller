<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="AccentBrush" Color="#91C7F2"/><SolidColorBrush x:Key="CardBrush" Color="#11151A"/><SolidColorBrush x:Key="HeaderBrush" Color="#1D222D"/>
 <Style TargetType="Expander"><Setter Property="Foreground" Value="#D4E5F8"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#293442"/><Setter Property="Foreground" Value="#E2EEFC"/><Setter Property="Padding" Value="14,8"/><Setter Property="BorderBrush" Value="#445366"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#96CDF9"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#11151A"/><Setter Property="Foreground" Value="#D4E5F8"/><Setter Property="BorderBrush" Value="#445366"/><Setter Property="Padding" Value="8"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#96A6B9"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="FontSize" Value="36"/><Setter Property="FontWeight" Value="Light"/></Style>
</ResourceDictionary>