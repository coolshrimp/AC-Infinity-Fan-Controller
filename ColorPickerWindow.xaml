<Window x:Class="ACInfinityDesktop.ColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Custom color" Width="420" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" ResizeMode="NoResize" ShowInTaskbar="False" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Window.Resources><ResourceDictionary Source="Theme.xaml"/></Window.Resources>
 <Border Padding="18" CornerRadius="18" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"><StackPanel>
  <DockPanel Margin="0,0,0,14"><Button Content="×" Click="Cancel_Click" DockPanel.Dock="Right" Padding="8,3" ToolTip="Cancel color changes"/><TextBlock x:Name="PickerTitle" Text="Custom color" FontSize="18" VerticalAlignment="Center"/></DockPanel>
  <Border x:Name="ColorArea" Height="210" Background="Red" ClipToBounds="True" Focusable="True" ToolTip="Choose saturation and brightness. Arrow keys adjust the selection." MouseLeftButtonDown="Area_Down" MouseMove="Area_Move" MouseLeftButtonUp="Area_Up" KeyDown="Area_Key" SizeChanged="Area_Size">
   <Grid><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Canvas IsHitTestVisible="False"><Ellipse x:Name="SelectionDot" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent"><Ellipse.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Color="Black"/></Ellipse.Effect></Ellipse></Canvas></Grid>
  </Border>
  <TextBlock Text="Hue" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
  <Grid><Border Height="8" Margin="8,0" CornerRadius="4"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.167"/><GradientStop Color="Lime" Offset="0.333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.667"/><GradientStop Color="Magenta" Offset="0.833"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Border.Background></Border><Slider x:Name="HueSlider" Style="{StaticResource UimModernSlider}" Minimum="0" Maximum="359.9" Foreground="Transparent" Background="Transparent" SmallChange="1" LargeChange="10" ValueChanged="Hue_Changed" ToolTip="Choose a hue"/></Grid>
  <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="PreviewSwatch" Background="Red" CornerRadius="6" Margin="0,0,10,0" BorderBrush="#8899AA" BorderThickness="1"/><StackPanel Grid.Column="1"><TextBlock Text="Hex color" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox x:Name="HexBox" Text="#FF0000" MaxLength="7" TextChanged="Hex_Changed" ToolTip="Enter six hexadecimal digits, such as #91C7F2"/></StackPanel></Grid>
  <TextBlock x:Name="ValidationText" Foreground="#FCA5A5" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Cancel" Click="Cancel_Click" ToolTip="Keep the original color"/><Button x:Name="UseButton" Grid.Column="1" Content="Use color" Click="Use_Click" ToolTip="Save this color and return to appearance settings"/></Grid>
 </StackPanel></Border>
</Window>
